# Скопируйте в .env и заполните значения:
# cp .env.example .env

# Обязательно — токен от @BotFather
BOT_TOKEN=

# Панель администратора (смените пароль!)
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=change_me_strong_password
ADMIN_JWT_SECRET=change_me_random_long_secret

# Telegram ID админов через запятую (уведомления о заявках)
ADMIN_IDS=123456789

# Platega (оплата)
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_CALLBACK_URL=https://your-domain.com/api/webhooks/platega
PLATEGA_RETURN_URL=https://your-domain.com/payment/success
PLATEGA_FAILED_URL=https://your-domain.com/payment/fail

# Noren / Crypto Cash — ключи в админке → Настройки → Способы оплаты (на каждый бот).
# PAYMENT_PROVIDER=crypto_cash — провайдер для CC (Exchange ID = merchant_order_id).
# Webhook URL для кабинета Noren:
# https://your-domain.com/api/webhooks/noren
# или https://your-domain.com/api/webhooks/crypto_cash
PAYMENT_PROVIDER=crypto_cash

# Опционально
DEBUG=release
API_PORT=8000
